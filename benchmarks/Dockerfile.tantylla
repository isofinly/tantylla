# =========================================================================
# Tantylla: Multi-stage Docker Build
# =========================================================================
#
# Builds all three tantylla binaries (node, ingestor, gateway) from the
# Rust workspace. The build context MUST be the project root (parent of
# benchmarks/) so that `COPY rust/ ...` resolves correctly.
#
# Build context: <project-root>
# Dockerfile:    benchmarks/Dockerfile.tantylla
#
# For faster rebuilds, consider adding a .dockerignore at the project
# root that excludes scylladb/, rust/target/, and .git/.

# -------------------------------------------------------------------------
# Stage 1: Compile release binaries
# -------------------------------------------------------------------------
# We pin the Rust version to match the project's MSRV (1.90).
# protobuf-compiler is needed for tonic-prost-build in common/build.rs.

FROM rust:1.90-slim-bookworm AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       protobuf-compiler \
       pkg-config \
       libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy only the Rust workspace — not the scylladb/ submodule or other
# top-level directories that would bloat the image layers.
COPY rust/ ./

RUN cargo build --release \
    -p tantylla-node \
    -p tantylla-ingestor \
    -p tantylla-gateway

# -------------------------------------------------------------------------
# Stage 2: Minimal runtime image
# -------------------------------------------------------------------------
# Debian bookworm-slim matches the builder's libc. We need libssl3 for
# the ingestor's ScyllaDB driver (TLS handshake during initial connect).

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/tantylla-node     /usr/local/bin/
COPY --from=builder /app/target/release/tantylla-ingestor /usr/local/bin/
COPY --from=builder /app/target/release/tantylla-gateway  /usr/local/bin/

# Default working directory — node stores its Tantivy index relative
# to CWD at ./index-<port>.
WORKDIR /data

# Default entrypoint is the node binary; ingestor and gateway containers
# override this in their docker_container resource.
ENTRYPOINT ["tantylla-node"]
