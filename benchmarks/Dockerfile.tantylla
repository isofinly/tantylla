FROM rust:1.90-slim-bookworm AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       protobuf-compiler \
       pkg-config \
       libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY rust/ ./

RUN cargo build --release \
    -p tantylla-node \
    -p tantylla-ingestor \
    -p tantylla-gateway

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/tantylla-node     /usr/local/bin/
COPY --from=builder /app/target/release/tantylla-ingestor /usr/local/bin/
COPY --from=builder /app/target/release/tantylla-gateway  /usr/local/bin/

# Default working directory — node stores its Tantivy index relative
# to CWD at ./index-<port>.
WORKDIR /data

# Default entrypoint is the node binary; ingestor and gateway containers
# override this in their docker_container resource.
ENTRYPOINT ["tantylla-node"]
